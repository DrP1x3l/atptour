# Esempio di configurazione. Copia in .env e personalizza.

# -- API --
NODE_ENV=production
API_PORT=3012

# Connessione al Postgres del Lonaserver (container "server-postgres")
# In dev locale puoi usare un Postgres tuo:
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/atptour
# Sul Lonaserver (stessa rete OrbStack):
#   DATABASE_URL=postgresql://atptour:CHANGE_ME@server-postgres:5432/atptour
DATABASE_URL=postgresql://atptour:CHANGE_ME@server-postgres:5432/atptour

# Shared secret per autenticare le chiamate API.
# Genera con: openssl rand -hex 32
APP_SECRET=replace-me-with-a-real-secret

# CORS: dominio dove gira il frontend (in prod via Cloudflare)
CORS_ORIGIN=https://atptour.example.com

# Redis (opzionale, per rate-limit o cache; vuoto = disabilitato)
REDIS_URL=redis://server-redis:6379/1

# -- WEB --
WEB_PORT=3011
# Lo stesso APP_SECRET deve essere noto al frontend in build-time (è incorporato
# nel bundle: per single-user va bene; mai usare in multi-utente!)
VITE_APP_SECRET=replace-me-with-a-real-secret
VITE_API_BASE=/api
