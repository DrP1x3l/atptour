# Esempio di configurazione. Copia in .env e personalizza.
# Architettura: MONOLITE - un solo container Node che serve sia API sia frontend.

NODE_ENV=production

# Porta esposta su 127.0.0.1 (host). Il container ascolta sempre su 3000 internamente.
# Default sul Lonaserver: 3018 (libera nella mappa stack).
HOST_PORT=3018

# Connessione al Postgres del Lonaserver (container "server-postgres", stessa rete OrbStack)
# In dev locale puoi usare un Postgres tuo o quello del compose decommentato:
#   DATABASE_URL=postgresql://atptour:dev@localhost:5433/atptour
DATABASE_URL=postgresql://atptour:CHANGE_ME@server-postgres:5432/atptour

# Shared secret per autenticare le chiamate API.
# Genera con: openssl rand -hex 32
APP_SECRET=replace-me-with-a-real-secret

# CORS: dominio dove gira il frontend. Same-origin (stesso container) => puoi
# lasciare * oppure mettere il tuo dominio Cloudflare.
CORS_ORIGIN=https://tennis.lonardoni.it

# Redis (opzionale, per rate-limit o cache; vuoto = disabilitato)
REDIS_URL=redis://server-redis:6379/1

# -- Vite build-time --
# VITE_APP_SECRET deve essere uguale ad APP_SECRET (incorporato nel bundle).
# Per single-user va bene; mai usare in multi-utente.
VITE_APP_SECRET=replace-me-with-a-real-secret
VITE_API_BASE=/api
